{
  "schemaVersion": "v6",
  "image": "/assets/Icons/eight-ball",
  "generateName": true,
  "tags": [
    {
      "key": "app",
      "value": "rcp"
    },
    {
      "key": "category",
      "value": "product"
    }
  ],
  "spec": {
    "display": {
      "name": "RCP \u00b7 Users & tenants",
      "description": "Who uses the system: active users, usage per tenant and role, debtor (client view) sessions, and who is hitting errors. Generated by docs/observability/signoz/tools/build_dashboards.py; edit the generator, not the JSON."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "service.name",
            "description": "Deployment(s) to show"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          },
          "name": "service.name"
        }
      }
    ],
    "panels": {
      "read-this-first-note": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Note",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/TextPanel",
            "spec": {
              "mode": "markdown",
              "text": "**Empty panels are a deployment gap, not a dashboard bug.** User and tenant attributes (`enduser.id`, `app.tenant`, `app.client.id`) come from the `EnrichTraceContext` middleware. A deployment that does not run it yet shows nothing here. Check with `app.tenant EXISTS` in the Traces explorer.",
              "presentation": {
                "textAlign": "left",
                "verticalAlign": "top"
              },
              "headerOptions": {
                "hide": true
              }
            }
          },
          "queries": [],
          "links": []
        }
      },
      "selected-period-active-users": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active users",
            "description": "Distinct signed-in users."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND kind_string = 'Server' AND enduser.id EXISTS"
                    },
                    "groupBy": [],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "",
                    "aggregations": [
                      {
                        "expression": "count_distinct(enduser.id)"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
