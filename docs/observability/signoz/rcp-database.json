      },
      "statements-heaviest-statements": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Heaviest statements",
            "description": "The 30 that cost the most total time, which is what loads the database: a fast statement that runs a million times beats one slow report."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "columnUnits": {
                  "A.sum(duration_nano)": "ns",
                  "A.p95(duration_nano)": "ns"
                },
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND name LIKE 'sql%'"
                    },
                    "groupBy": [
                      {
                        "name": "db.query.text",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [
                      {
                        "key": {
                          "name": "sum(duration_nano)",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "",
                    "aggregations": [
                      {
                        "expression": "sum(duration_nano)",
                        "alias": "Total time"
                      },
                      {
                        "expression": "count()",
                        "alias": "Runs"
                      },
                      {
                        "expression": "p95(duration_nano)",
                        "alias": "p95"
                      }
                    ],
                    "limit": 30
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "statements-load-by-database": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Load by database",
            "description": "Which deployment works on which database. A database you did not expect under a service means two applications share one service name."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
