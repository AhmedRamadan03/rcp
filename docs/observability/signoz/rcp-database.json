              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND name LIKE 'sql%'"
                    },
                    "groupBy": [
                      {
                        "name": "db.namespace",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "service.name",
                        "signal": "",
                        "fieldContext": "resource",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [
                      {
                        "key": {
                          "name": "sum(duration_nano)",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "",
                    "aggregations": [
                      {
                        "expression": "sum(duration_nano)",
                        "alias": "Total time"
                      },
                      {
                        "expression": "count()",
                        "alias": "Statements"
                      }
                    ],
                    "limit": 30
                  }
                }
              }
            }
          ],
          "links": []
