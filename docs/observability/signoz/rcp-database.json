{
  "schemaVersion": "v6",
  "image": "/assets/Icons/eight-ball",
  "generateName": true,
  "tags": [
    {
      "key": "app",
      "value": "rcp"
    },
    {
      "key": "category",
      "value": "application"
    }
  ],
  "spec": {
    "display": {
      "name": "RCP \u00b7 Database",
      "description": "The database as the application sees it: how many statements, how slow, which ones. Requests, scheduled commands and queue workers are all in here. Cloud SQL's own CPU, connections and locks need the mysql receiver and are not here. Generated by docs/observability/signoz/tools/build_dashboards.py; edit the generator, not the JSON."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "service.name",
            "description": "Deployment(s) to show"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          },
          "name": "service.name"
        }
      }
    ],
    "panels": {
      "selected-period-statements": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Statements",
            "description": "Executed SQL statements."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND name LIKE 'sql%'"
                    },
                    "groupBy": [],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "selected-period-time-in-sql": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Time in SQL",
            "description": "All statement durations added up: what the application asked of the database. The table below says which statements it went to."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "ns",
                "decimalPrecision": "1"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND name LIKE 'sql%'"
                    },
                    "groupBy": [],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "",
                    "aggregations": [
                      {
                        "expression": "sum(duration_nano)"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "selected-period-p95-duration": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "p95 duration",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "ns",
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND name LIKE 'sql%'"
                    },
                    "groupBy": [],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "",
                    "aggregations": [
                      {
                        "expression": "p95(duration_nano)"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "selected-period-failed-statements": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Failed statements",
            "description": "Failed connects, prepares and executes."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "thresholds": [
                {
                  "value": 0,
                  "operator": "above",
                  "unit": "none",
                  "color": "Red",
                  "format": "background"
                },
                {
                  "value": 0,
                  "operator": "below_or_equal",
                  "unit": "none",
                  "color": "Green",
                  "format": "text"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND db.system.name EXISTS AND has_error = true"
                    },
                    "groupBy": [],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "trends-statements-by-operation": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Statements by operation",
            "description": "Span name: sql SELECT, sql INSERT, ..."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false,
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND name LIKE 'sql%'"
                    },
                    "groupBy": [
                      {
                        "name": "name",
                        "signal": "",
                        "fieldContext": "span",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{name}}",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "trends-duration-p50-p95": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Duration p50 / p95",
            "description": ""
