          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "traces",
                          "source": "",
                          "disabled": false,
                          "filter": {
                            "expression": "service.name IN $service.name AND name LIKE 'sql%'"
                          },
                          "groupBy": [
                            {
                              "name": "service.name",
                              "signal": "",
                              "fieldContext": "resource",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "p50 {{service.name}}",
                          "aggregations": [
                            {
                              "expression": "p50(duration_nano)"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "traces",
                          "source": "",
                          "disabled": false,
                          "filter": {
                            "expression": "service.name IN $service.name AND name LIKE 'sql%'"
                          },
                          "groupBy": [
                            {
                              "name": "service.name",
                              "signal": "",
                              "fieldContext": "resource",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "p95 {{service.name}}",
                          "aggregations": [
                            {
                              "expression": "p95(duration_nano)"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
