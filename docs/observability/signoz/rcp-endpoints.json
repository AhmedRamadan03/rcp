      "client-errors-4xx-4xx-by-route-and-status": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "4xx by route and status",
            "description": "Adds up to the 4xx slice. Route n/a is a path that matched no route, mostly scanners. 422 is validation, 404 on a listed route is a missing record. 401 / 403 / 419 / 429 are on RCP \u00b7 Security & access."
