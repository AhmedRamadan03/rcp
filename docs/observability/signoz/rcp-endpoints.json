{
  "schemaVersion": "v6",
  "image": "/assets/Icons/eight-ball",
  "generateName": true,
  "tags": [
    {
      "key": "app",
      "value": "rcp"
    },
    {
      "key": "category",
      "value": "application"
    }
  ],
  "spec": {
    "display": {
      "name": "RCP \u00b7 Endpoints",
      "description": "Per route: which features are used, which are slow, which fail. Drill-down for RCP \u00b7 Service health. Generated by docs/observability/signoz/tools/build_dashboards.py; edit the generator, not the JSON."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "service.name",
            "description": "Deployment(s) to show"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          },
          "name": "service.name"
        }
      }
    ],
    "panels": {
      "all-endpoints-endpoint-summary": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Endpoint summary",
            "description": "One row per route, busiest first. Click a header to sort."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "columnUnits": {
                  "P": "ns",
                  "Q": "ns",
                  "R": "ns",
                  "F2": "percent"
                },
                "decimalPrecision": "2"
              },
              "thresholds": [
                {
                  "value": 0,
                  "operator": "above",
                  "unit": "none",
                  "color": "Red",
                  "format": "text",
                  "columnName": "F1"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "traces",
                          "source": "",
                          "disabled": false,
                          "filter": {
                            "expression": "service.name IN $service.name AND kind_string = 'Server' AND http.route EXISTS"
                          },
                          "groupBy": [
                            {
                              "name": "service.name",
                              "signal": "",
                              "fieldContext": "resource",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http_method",
                              "signal": "",
                              "fieldContext": "span",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http.route",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [
                            {
                              "key": {
                                "name": "count()",
                                "signal": "",
                                "fieldContext": "",
                                "fieldDataType": ""
                              },
                              "direction": "desc"
                            }
                          ],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "Requests",
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "traces",
                          "source": "",
                          "disabled": true,
                          "filter": {
                            "expression": "service.name IN $service.name AND kind_string = 'Server' AND http.route EXISTS AND has_error = false"
                          },
                          "groupBy": [
                            {
                              "name": "service.name",
                              "signal": "",
                              "fieldContext": "resource",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http_method",
                              "signal": "",
                              "fieldContext": "span",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http.route",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "",
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "P",
                          "signal": "traces",
                          "source": "",
                          "disabled": false,
                          "filter": {
                            "expression": "service.name IN $service.name AND kind_string = 'Server' AND http.route EXISTS"
                          },
                          "groupBy": [
                            {
                              "name": "service.name",
                              "signal": "",
                              "fieldContext": "resource",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http_method",
                              "signal": "",
                              "fieldContext": "span",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http.route",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "p50",
                          "aggregations": [
                            {
                              "expression": "p50(duration_nano)"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "Q",
                          "signal": "traces",
                          "source": "",
                          "disabled": false,
                          "filter": {
                            "expression": "service.name IN $service.name AND kind_string = 'Server' AND http.route EXISTS"
                          },
                          "groupBy": [
                            {
                              "name": "service.name",
                              "signal": "",
                              "fieldContext": "resource",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http_method",
                              "signal": "",
                              "fieldContext": "span",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http.route",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "p95",
                          "aggregations": [
                            {
                              "expression": "p95(duration_nano)"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "R",
                          "signal": "traces",
                          "source": "",
                          "disabled": false,
                          "filter": {
                            "expression": "service.name IN $service.name AND kind_string = 'Server' AND http.route EXISTS"
                          },
                          "groupBy": [
                            {
                              "name": "service.name",
                              "signal": "",
                              "fieldContext": "resource",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http_method",
                              "signal": "",
                              "fieldContext": "span",
                              "fieldDataType": "string"
                            },
                            {
                              "name": "http.route",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "p99",
                          "aggregations": [
                            {
                              "expression": "p99(duration_nano)"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "A-B",
                          "disabled": false,
                          "having": {
                            "expression": ""
                          },
                          "legend": "Failed"
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F2",
                          "expression": "((A-B)/A)*100",
                          "disabled": false,
                          "having": {
                            "expression": ""
                          },
                          "legend": "Error %"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
