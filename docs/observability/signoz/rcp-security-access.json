      "selected-period-refused-requests-by-status": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Refused requests by status",
            "description": "A sudden wall of one colour is an attack or a broken release. Red is 403, amber 401, blue 429, green 419."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": true,
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {
                  "419": "#1baf7a",
                  "429": "#3987e5",
                  "401": "#c98500",
                  "403": "#d03b3b"
                }
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service.name AND kind_string = 'Server' AND response_status_code IN ('401', '403', '419', '429')"
                    },
                    "groupBy": [
                      {
                        "name": "response_status_code",
                        "signal": "",
                        "fieldContext": "span",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{response_status_code}}",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
