{
  "schemaVersion": "v6",
  "image": "/assets/Icons/eight-ball",
  "generateName": true,
  "tags": [
    {
      "key": "app",
      "value": "rcp"
    },
    {
      "key": "category",
      "value": "health"
    }
  ],
  "spec": {
    "display": {
      "name": "RCP \u00b7 Availability",
      "description": "Are the deployments up, and how available were they over the selected period (set 7 or 30 days for the SLO view)? Request-based: a request fails when it ends in a 5xx or an unhandled exception. A full outage produces no requests at all, so read the heartbeats together with the GCP uptime checks on /api/health. Generated by docs/observability/signoz/tools/build_dashboards.py; edit the generator, not the JSON."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "service.name",
            "description": "Deployment(s) to show"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          },
          "name": "service.name"
        }
      }
    ],
    "panels": {
      "selected-period-availability": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Availability",
            "description": "Successful requests / all requests. Health-check probes are not traced, so they do not inflate this."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "percent",
                "decimalPrecision": "3"
              },
              "thresholds": [
                {
                  "value": 99.5,
                  "operator": "below",
                  "unit": "percent",
                  "color": "Red",
                  "format": "background"
                },
                {
                  "value": 99.5,
                  "operator": "above_or_equal",
                  "unit": "percent",
                  "color": "Green",
                  "format": "text"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "traces",
                          "source": "",
                          "disabled": true,
                          "filter": {
                            "expression": "service.name IN $service.name AND kind_string = 'Server' AND has_error = false"
                          },
                          "groupBy": [],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "",
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "traces",
                          "source": "",
                          "disabled": true,
                          "filter": {
                            "expression": "service.name IN $service.name AND kind_string = 'Server'"
                          },
                          "groupBy": [],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "",
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "(A/B)*100",
                          "disabled": false,
                          "having": {
                            "expression": ""
                          },
                          "legend": "Availability"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
