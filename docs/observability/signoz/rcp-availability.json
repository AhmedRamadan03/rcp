      "heartbeats-scheduler-schedule-run": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Scheduler: schedule:run",
            "description": "Cron starts the scheduler every minute, so a deployment's bars are all equally tall; a hole or a short bar means cron stopped. Twice the expected height means two crons. Empty without OTEL_PHP_TRACE_CLI_ENABLED=true."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
